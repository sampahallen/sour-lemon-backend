PORT=4000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=sour_lemon_refresh_token
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_IDLE_HOURS=2
CUSTOMER_SESSION_HOURS=720
CUSTOMER_SESSION_IDLE_HOURS=168
ADMIN_APP_ORIGIN=http://localhost:5174
CUSTOMER_APP_ORIGIN=http://localhost:5173
# In production use HTTPS app origins under the same site as the API.
# Temporary during backend-first client rollout only; disable after clients update.
ALLOW_LEGACY_ACCESS_TOKENS=false
GUEST_CART_COOKIE_NAME=sour_lemon_guest_cart

# Customer password reset email. For port 465 use SMTP_SECURE=true; for
# STARTTLS ports such as 587 use SMTP_SECURE=false.
CUSTOMER_APP_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Sour Lemon <orders@example.com>
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Use DATABASE_URL when your PostgreSQL provider supplies one. When set, it
# takes precedence over the individual DB_* settings below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sour_lemon

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sour_lemon
DB_USER=postgres
DB_PASSWORD=postgres

# Enable these for hosted PostgreSQL providers that require SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Journal image storage. Keep the S3 bucket private and serve objects through
# the configured CloudFront (or other public CDN) base URL.
AWS_REGION=af-south-1
AWS_S3_BUCKET=this-is-the-bucket-name
AWS_S3_PUBLIC_BASE_URL=https://your-cloudfront-domain-name.com
AWS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX-20
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-40
JOURNAL_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_BYTES=5242880

# Paystack test-mode keys for card/MoMo checkout. Get these from your Paystack
# dashboard (Settings > API Keys & Webhooks) — never commit real values here.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
